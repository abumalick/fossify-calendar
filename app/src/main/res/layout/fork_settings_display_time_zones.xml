<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fork_settings_display_time_zones_holder"
    style="@style/SettingsHolderTextViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/fork_settings_display_time_zones_label"
        style="@style/SettingsTextLabelStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/fork_display_time_zones" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/fork_settings_display_time_zones"
        style="@style/SettingsTextValueStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/fork_settings_display_time_zones_label"
        tools:text="Brussels, London" />

</RelativeLayout>
